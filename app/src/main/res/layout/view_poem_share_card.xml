<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FAF6EE"
    android:padding="32dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvCardFlourishTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✦ ── ✤ ── ✦"
        android:textColor="#9A6A1A"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCardSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="अनुभूति के स्वर"
        android:textColor="#C0392B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="गीत नया गाता हूँ"
        android:textColor="#9A6A1A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/tvCardPoemText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="टूटे हुए तारों से फूटे बासंती स्वर,
पत्थर की छाती में उग आया नव अंकुर..."
        android:textColor="#201E1B"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:textAlignment="center"
        android:layout_marginBottom="22dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="~ ❖ ~"
        android:textColor="#9A6A1A"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivCardAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/avatar_vajpayee"
            android:contentDescription="अटल बिहारी वाजपेयी" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="अटल बिहारी वाजपेयी"
                android:textColor="#201E1B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="मेरी इक्यावन कविताएँ"
                android:textColor="#6B6559"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>